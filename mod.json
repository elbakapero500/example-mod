{
  "geode": "5.11.2",
  "gd": "*",
  "id": "elbakapero500.click-buffer",
  "name": "Click Buffer",
  "version": "v1.0.0",
  "developer": "elbakapero500",
  "description": "Más margen para clickear, con registro.",
  "settings": {
    "frames": {
      "type": "int",
      "default": 3,
      "min": 1,
      "max": 8,
      "name": "Frames de margen"
    },
    "indicator": {
      "type": "bool",
      "default": true,
      "name": "Mostrar aviso en pantalla"
    },
    "log": {
      "type": "bool",
      "default": true,
      "name": "Escribir en el log"
    }
  }
}
