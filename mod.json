{
  "geode": "$GEODE_VERSION",
  "gd": {
    "win": "2.2074",
    "android": "2.2074",
    "mac": "2.2074",
    "ios": "2.2074"
  },
  "id": "bakapero500.click-buffer",
  "name": "Click Buffer con registro",
  "version": "1.0.0",
  "developer": "bakapero500",
  "description": "Repite clicks durante unos pasos y registra actividad en pantalla y en el log.",
  "settings": {
    "frames": {
      "type": "int",
      "default": 3,
      "min": 1,
      "max": 8,
      "name": "Frames de margen"
    },
    "indicator": {
      "type": "bool",
      "default": true,
      "name": "Mostrar aviso en pantalla"
    },
    "log": {
      "type": "bool",
      "default": true,
      "name": "Escribir en el log"
    }
  }
}
